# Slack credentials (required)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# Optional: enable Socket Mode (no public URL needed for development)
# SLACK_APP_TOKEN=xapp-your-app-level-token

# Optional: default Slack channel for API routes (so you don't need to pass channel every time)
# SLACK_DEFAULT_CHANNEL=C0123ABCDEF

# Server port
PORT=3000
